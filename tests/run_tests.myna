@target(py)
<sys

# Run from the repository root:
#   python3 -m myna run --module-root . tests/run_tests.myna
# `--module-root .` lets this entry import `.tests.*` while test modules reach
# the source tree as `..src.*` (replacing the old tests/src symlink workaround).

<.tests.test_myna_lexer:{run_myna_lexer_tests}
<.tests.test_companions:{run_companion_tests}
<.tests.test_html_proc:{run_html_tests}
<.tests.test_lossless:{run_lossless_tests}
<.tests.test_site:{run_site_tests}

@main {
  p("MynaShine test suite")
  p("====================")
  total_p = 0
  total_f = 0
  a = run_myna_lexer_tests()
  total_p += a[0]
  total_f += a[1]
  b = run_companion_tests()
  total_p += b[0]
  total_f += b[1]
  c = run_html_tests()
  total_p += c[0]
  total_f += c[1]
  d = run_lossless_tests()
  total_p += d[0]
  total_f += d[1]
  e = run_site_tests()
  total_p += e[0]
  total_f += e[1]
  p("====================")
  p(`TOTAL: {total_p} passed, {total_f} failed`)
  ? total_f > 0 {
    sys.exit(1)
  }
}
